# PATUJU POS — Git Ignore

# Variables de entorno — nunca versionar credenciales reales
.env

# Dumps y herramientas de contexto
repomix*

# Documentos temporales o binarios de oficina
*.docx
*.tmp

# Directorios de dependencias
vendor/

# Caché de PHPUnit
.phpunit.cache/
.phpunit.result.cache

# Archivos del sistema
.DS_Store
Thumbs.db

# Logs de PHP y servidor
*.log
