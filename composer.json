{
    "name": "patuju/pos",
    "description": "Patuju POS - Sistema de punto de venta multi-sucursal",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Patuju\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:integration": "phpunit --configuration phpunit.xml --testsuite Integration"
    },
    "config": {
        "sort-packages": true
    }
}
